.DS_Store
__pycache__/
*.pyc
.venv/
runs/
workspace/
*.egg-info/
.env
.env.*
watchdog.sh

# Local run logs and scratch
*.log
# Anchor run_*.sh to repo root only (Phase 20 γ) — without the leading
# slash, a future scripts/run_pipeline.sh or ci/run_smoke.sh would be
# silently ignored.
/run_*.sh
stage7_*stderr*.txt
validate_stderr_*.txt
validator_stderr_*.txt
.claude/scheduled_tasks.lock

# Local scratch experiments and one-off reports at repo root
/benchmark/
/experiments/*
!/experiments/E[0-9]*_*/
/*.pdf

# Phase 50 α: the eval suite's hidden half (generators, rubrics, answer keys, hidden tests,
# design note) lives only in the encrypted bundle (evals/README.md); never commit a
# decrypted copy or the bundle itself
/evals/**/_truth/
/evals/**/generate.py
/evals/**/rubric.yaml
/evals/_common.py
/evals/test_suite.py
/evals/legacy/
/evals/design/
/evals_private/
/eval_private_*/
/docs/design/eval-suite.md
bundle.enc
*.bundle.enc
